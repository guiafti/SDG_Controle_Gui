{
  "name": "pdv-grupo-import",
  "version": "1.0.0",
  "main": "dist/main/main.js",
  "description": "Sistema de PDV Desktop Offline-first",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build:main": "npx esbuild src/main/main.ts --bundle --platform=node --external:electron --external:sqlite3 --outfile=dist/main/main.js && npx esbuild src/main/preload.ts --bundle --platform=node --external:electron --outfile=dist/main/preload.js",
    "electron:dev": "npm run build:main && npx concurrently -k \"npm run dev\" \"npx electron .\""
  },
  "dependencies": {
    "@phosphor-icons/web": "^2.0.2",
    "@supabase/supabase-js": "^2.104.0",
    "clsx": "^2.0.0",
    "dotenv": "^17.4.2",
    "fast-xml-parser": "^4.2.7",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hot-toast": "^2.6.0",
    "sqlite3": "^5.1.6",
    "tailwind-merge": "^1.14.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.0.3",
    "autoprefixer": "^10.4.15",
    "concurrently": "^8.2.1",
    "electron": "^26.2.1",
    "electron-builder": "^24.6.4",
    "esbuild": "^0.19.2",
    "postcss": "^8.4.28",
    "tailwindcss": "^3.3.3",
    "typescript": "^5.0.2",
    "vite": "^4.4.5",
    "wait-on": "^7.0.1"
  }
}
